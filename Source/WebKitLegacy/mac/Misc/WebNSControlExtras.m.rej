diff a/Source/WebKitLegacy/mac/Misc/WebNSControlExtras.m b/Source/WebKitLegacy/mac/Misc/WebNSControlExtras.m	(rejected hunks)
@@ -48,7 +48,13 @@ - (void)sizeToFitAndAdjustWindowHeight
     NSRect windowFrame = [window frame];
 
     CGFloat backingScaleFactor;
+#if __MAC_OS_X_VERSION_MIN_REQUIRED >= 1070
     backingScaleFactor = [window backingScaleFactor];
+#else
+    // [leopard-webkit-build] NSWindow -backingScaleFactor is 10.7+ (Retina); on 10.6
+    // the backing scale is always 1.0 (no HiDPI displays).
+    backingScaleFactor = 1.0;
+#endif
 
     windowFrame.size.height += heightDelta * backingScaleFactor;
     [window setFrame:windowFrame display:NO];
