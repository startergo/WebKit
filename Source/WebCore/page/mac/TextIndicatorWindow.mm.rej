+    // [leopard-webkit-build] NSColor -CGColor is 10.8+; the 10.6 SDK has no such
+    // property. These are device-RGB/device-gray colors with known components, so
+    // build the CGColorRefs directly via CGColorCreateGenericRGB (10.5+, in
+    // CoreGraphics). The values match the original NSColor components exactly.
+    RetainPtr<CGColorRef> highlightColor = adoptCF(CGColorCreateGenericRGB(1, 1, 0, 1));
+    RetainPtr<CGColorRef> rimShadowColor = adoptCF(CGColorCreateGenericRGB(0, 0, 0, 0.35));
+    RetainPtr<CGColorRef> dropShadowColor = adoptCF(CGColorCreateGenericRGB(0, 0, 0, 0.2));
+
+    RetainPtr<CGColorRef> borderColor = adoptCF(CGColorCreateGenericRGB(0.96, 0.90, 0, 1));
 
