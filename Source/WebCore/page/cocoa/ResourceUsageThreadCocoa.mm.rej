diff a/Source/WebCore/page/cocoa/ResourceUsageThreadCocoa.mm b/Source/WebCore/page/cocoa/ResourceUsageThreadCocoa.mm	(rejected hunks)
@@ -129,8 +129,15 @@ std::array<TagInfo, 256> pagesPerVMTag()
 
         bool anonymous = !info.external_pager;
         if (anonymous) {
+#if __MAC_OS_X_VERSION_MIN_REQUIRED >= 1090
+            // [leopard-webkit-build] pages_reusable was added to
+            // vm_region_submap_info_64 in 10.9; on 10.6 treat all resident pages as
+            // dirty (no reusable subset reported by the kernel).
             tags[info.user_tag].dirty += info.pages_resident - info.pages_reusable;
             tags[info.user_tag].reclaimable += info.pages_reusable;
+#else
+            tags[info.user_tag].dirty += info.pages_resident;
+#endif
         } else
             tags[info.user_tag].dirty += info.pages_dirtied;
     }
