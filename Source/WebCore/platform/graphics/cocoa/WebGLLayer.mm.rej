diff a/Source/WebCore/platform/graphics/cocoa/WebGLLayer.mm b/Source/WebCore/platform/graphics/cocoa/WebGLLayer.mm	(rejected hunks)
@@ -56,7 +56,13 @@ using namespace WebCore;
 #if PLATFORM(MAC)
     self.contentsOpaque = !context->getContextAttributes().alpha;
     self.transform = CATransform3DIdentity;
+#if __MAC_OS_X_VERSION_MIN_REQUIRED >= 1070
+    // [leopard-webkit-build] CALayer.contentsScale is 10.7+ (Retina backing); 10.6
+    // has no Retina displays, so the device-pixel-ratio scale is inert — skip.
     self.contentsScale = _devicePixelRatio;
+#else
+    (void)_devicePixelRatio;
+#endif
 #else
     self.opaque = !context->getContextAttributes().alpha;
 #endif
@@ -178,8 +184,17 @@ static void freeData(void *, const void *data, size_t /* size */)
     GC3Denum internalFormat = _usingAlpha ? GL_RGBA : GL_RGB;
 
     // Link the IOSurface to the texture.
+#if __MAC_OS_X_VERSION_MIN_REQUIRED >= 1070
+    // [leopard-webkit-build] CGLTexImageIOSurface2D (IOSurface-backed CGL texture
+    // upload) is not declared in the 10.6 SDK header surface; gate to ≥10.7. On
+    // 10.6 the WebGL IOSurface fast-path is unavailable (WebGL falls back to the
+    // CPU raster path).
     CGLError error = CGLTexImageIOSurface2D(_context->platformGraphicsContext3D(), GL_TEXTURE_RECTANGLE_ARB, internalFormat, _bufferSize.width(), _bufferSize.height(), GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV, ioSurface, 0);
     ASSERT_UNUSED(error, error == kCGLNoError);
+#else
+    UNUSED_PARAM(internalFormat);
+    UNUSED_PARAM(ioSurface);
+#endif
 }
 #endif
 
