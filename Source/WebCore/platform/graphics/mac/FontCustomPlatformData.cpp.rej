+    char tempPath[PATH_MAX];
+    snprintf(tempPath, sizeof(tempPath), "%s/webkit-font.XXXXXX", tmpDir);
+    int fd = mkstemp(tempPath);
+    if (fd >= 0) {
+        CFIndex length = CFDataGetLength(bufferData.get());
+        ssize_t written = write(fd, CFDataGetBytePtr(bufferData.get()), length);
+        close(fd);
+        if (written == static_cast<ssize_t>(length)) {
+            RetainPtr<CFURLRef> tempURL = adoptCF(CFURLCreateFromFileSystemRepresentation(kCFAllocatorDefault, reinterpret_cast<const UInt8*>(tempPath), strlen(tempPath), false));
+            RetainPtr<CFArrayRef> descriptors = adoptCF(CTFontManagerCreateFontDescriptorsFromURL(tempURL.get()));
+            if (descriptors && CFArrayGetCount(descriptors.get()) > 0) {
+                CTFontDescriptorRef firstDesc = static_cast<CTFontDescriptorRef>(const_cast<void*>(CFArrayGetValueAtIndex(descriptors.get(), 0)));
+                fontDescriptor = adoptCF(static_cast<CTFontDescriptorRef>(CFRetain(firstDesc)));
+            }
+        }
+        unlink(tempPath);
+    }
+#endif
     if (!fontDescriptor)
