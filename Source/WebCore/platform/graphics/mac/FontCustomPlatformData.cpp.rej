@@ -47,7 +50,35 @@ std::unique_ptr<FontCustomPlatformData> createFontCustomPlatformData(SharedBuffe
 {
     RetainPtr<CFDataRef> bufferData = buffer.createCFData();
 
+#if __MAC_OS_X_VERSION_MIN_REQUIRED >= 1070
     RetainPtr<CTFontDescriptorRef> fontDescriptor = adoptCF(CTFontManagerCreateFontDescriptorFromData(bufferData.get()));
+#else
+    // [leopard-webkit-build] CTFontManagerCreateFontDescriptorFromData is 10.7+.
+    // 10.6 fallback: write the font data to a temp file and use the URL-based
+    // CTFontManagerCreateFontDescriptorsFromURL (available 10.6+). This preserves
