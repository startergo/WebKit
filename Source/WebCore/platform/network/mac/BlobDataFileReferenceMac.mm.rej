 typedef struct _BOMCopier* BOMCopier;
 
+// [leopard-webkit-build] NSFileCoordinator is 10.7+ Foundation. BlobDataFileReferenceMac
+// uses it to coordinate reading the blob source file. Declare the @interface here so
+// this TU compiles; sdk_stubs_605.mm provides the @implementation (no-op: invokes the
+// accessor block synchronously — safe on 10.6 which has no file presenters).
+#if __MAC_OS_X_VERSION_MAX_ALLOWED < 1070
+@interface NSFileCoordinator : NSObject
+- (instancetype)initWithFilePresenter:(id)presenter;
+- (void)coordinateReadingItemAtURL:(NSURL *)url options:(unsigned long)options error:(NSError **)error byAccessor:(void (^)(NSURL *))accessor;
+@end
+#endif
+
