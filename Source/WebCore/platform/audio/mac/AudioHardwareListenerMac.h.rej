+#if __MAC_OS_X_VERSION_MAX_ALLOWED < 1070
+// [leopard-webkit-build] AudioObjectPropertyListenerBlock and the block-based
+// AudioObject{Add,Remove}PropertyListenerBlock functions are 10.7+ CoreAudio.
+// The 10.6 SDK ships only the C-callback variant (AudioObjectPropertyListenerProc).
+// Provide the block typedef + extern declarations; sdk_stubs_605.mm supplies no-op
+// implementations (audio-hardware change callbacks are inert on 10.6 — degraded
+// but functional; Safari launches without dynamic output-device-change detection).
+typedef void (^AudioObjectPropertyListenerBlock)(UInt32, const AudioObjectPropertyAddress[]);
+extern OSStatus AudioObjectAddPropertyListenerBlock(AudioObjectID, const AudioObjectPropertyAddress*, dispatch_queue_t, AudioObjectPropertyListenerBlock);
+extern OSStatus AudioObjectRemovePropertyListenerBlock(AudioObjectID, const AudioObjectPropertyAddress*, dispatch_queue_t, AudioObjectPropertyListenerBlock);
+#endif
+
